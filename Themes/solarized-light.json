{
  // Solarized Light, converted from Synta's own theme format. VS Code colour theme format, also used by Syntax.
  "name": "Solarized Light",
  "type": "light",
  "colors": {
    "mdview.markBackground": "#fff59d",
    "mdview.markForeground": "#24292e",
    "mdview.findBackground": "#fff0a6",
    "mdview.findForeground": "#24292e",
    "mdview.findActiveBackground": "#ff9800",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#657b83",
    "focusBorder": "#268bd2",
    "editor.background": "#fdf6e3",
    "editor.foreground": "#657b83",
    "editorGutter.background": "#fdf6e3",
    "editorLineNumber.foreground": "#93a1a199",
    "editorLineNumber.activeForeground": "#93a1a1",
    "editor.lineHighlightBackground": "#93a1a122",
    "editor.selectionBackground": "#268bd226",
    "editor.inactiveSelectionBackground": "#93a1a133",
    "editor.findMatchBackground": "#268bd244",
    "editorIndentGuide.background1": "#93a1a133",
    "editorCursor.foreground": "#657b83",
    "textLink.foreground": "#268bd2",
    "titleBar.activeBackground": "#f5f0de",
    "titleBar.activeForeground": "#657b83",
    "titleBar.border": "#e8e5d6",
    "menu.background": "#fdf6e3",
    "menu.foreground": "#657b83",
    "menu.selectionBackground": "#eeead9",
    "menu.separatorBackground": "#e8e5d6",
    "statusBar.background": "#f5f0de",
    "statusBar.foreground": "#9aa6a5",
    "editorGroupHeader.tabsBackground": "#f5f0de",
    "tab.activeBackground": "#fdf6e3",
    "tab.inactiveBackground": "#f5f0de",
    "tab.hoverBackground": "#eeead9",
    "tab.activeForeground": "#657b83",
    "tab.inactiveForeground": "#9aa6a5",
    "tab.activeBorderTop": "#268bd2",
    "tab.border": "#e8e5d6"
  },
  "tokenColors": [
    { "settings": { "foreground": "#657b83" } },
    { "scope": ["keyword"], "settings": { "foreground": "#859900" } },
    { "scope": ["keyword.control.flow"], "settings": { "foreground": "#859900" } },
    { "scope": ["entity.name.type"], "settings": { "foreground": "#b58900" } },
    { "scope": ["entity.other.inherited-class"], "settings": { "foreground": "#b58900" } },
    { "scope": ["constant.language"], "settings": { "foreground": "#2aa198" } },
    { "scope": ["support.function"], "settings": { "foreground": "#268bd2" } },
    { "scope": ["keyword.other.unit"], "settings": { "foreground": "#d33682" } },
    { "scope": ["entity.name.function"], "settings": { "foreground": "#268bd2" } },
    { "scope": ["string"], "settings": { "foreground": "#2aa198" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#cb4b16" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#d33682" } },
    { "scope": ["comment"], "settings": { "foreground": "#93a1a1", "fontStyle": "italic" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#859900" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#657b83b3" } },
    { "scope": ["meta.preprocessor"], "settings": { "foreground": "#cb4b16" } },
    { "scope": ["meta.annotation"], "settings": { "foreground": "#cb4b16" } },
    { "scope": ["variable"], "settings": { "foreground": "#cb4b16" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#268bd2" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#268bd2" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#b58900" } },
    { "scope": ["constant.character.entity"], "settings": { "foreground": "#cb4b16" } },
    { "scope": ["entity.name.section"], "settings": { "foreground": "#b58900", "fontStyle": "bold" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#cb4b16", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#cb4b16", "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#cb4b16", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#268bd2" } },
    { "scope": ["markup.inline.raw"], "settings": { "foreground": "#2aa198" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#859900" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#dc322f" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#b58900" } }
  ]
}
