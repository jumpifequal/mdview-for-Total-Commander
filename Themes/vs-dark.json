{
  // Visual Studio Dark, converted from Synta's own theme format. VS Code colour theme format, also used by Syntax.
  "name": "Visual Studio Dark",
  "type": "dark",
  "colors": {
    "mdview.markBackground": "#7a5d00",
    "mdview.markForeground": "#fff7cc",
    "mdview.findBackground": "#6d5200",
    "mdview.findForeground": "#fff4cb",
    "mdview.findActiveBackground": "#ffb454",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#d4d4d4",
    "focusBorder": "#3794ff",
    "editor.background": "#1e1e1e",
    "editor.foreground": "#d4d4d4",
    "editorGutter.background": "#1e1e1e",
    "editorLineNumber.foreground": "#85858599",
    "editorLineNumber.activeForeground": "#858585",
    "editor.lineHighlightBackground": "#85858522",
    "editor.selectionBackground": "#264f78",
    "editor.selectionHighlightBackground": "#add6ff26",
    "editor.inactiveSelectionBackground": "#3a3d41",
    "editor.findMatchBackground": "#515c6a",
    "editorIndentGuide.background1": "#85858533",
    "editorCursor.foreground": "#d4d4d4",
    "textLink.foreground": "#3794ff",
    "titleBar.activeBackground": "#272727",
    "titleBar.activeForeground": "#d4d4d4",
    "titleBar.border": "#373737",
    "menu.background": "#1e1e1e",
    "menu.foreground": "#d4d4d4",
    "menu.selectionBackground": "#303030",
    "menu.separatorBackground": "#373737",
    "statusBar.background": "#272727",
    "statusBar.foreground": "#949494",
    "editorGroupHeader.tabsBackground": "#272727",
    "tab.activeBackground": "#1e1e1e",
    "tab.inactiveBackground": "#272727",
    "tab.hoverBackground": "#303030",
    "tab.activeForeground": "#d4d4d4",
    "tab.inactiveForeground": "#949494",
    "tab.activeBorderTop": "#3794ff",
    "tab.border": "#373737"
  },
  "tokenColors": [
    { "settings": { "foreground": "#d4d4d4" } },
    { "scope": ["keyword"], "settings": { "foreground": "#569cd6" } },
    { "scope": ["keyword.control.flow"], "settings": { "foreground": "#c586c0" } },
    { "scope": ["entity.name.type"], "settings": { "foreground": "#4ec9b0" } },
    { "scope": ["entity.other.inherited-class"], "settings": { "foreground": "#4ec9b0" } },
    { "scope": ["constant.language"], "settings": { "foreground": "#4fc1ff" } },
    { "scope": ["support.function"], "settings": { "foreground": "#9cdcfe" } },
    { "scope": ["keyword.other.unit"], "settings": { "foreground": "#b5cea8" } },
    { "scope": ["entity.name.function"], "settings": { "foreground": "#dcdcaa" } },
    { "scope": ["string"], "settings": { "foreground": "#ce9178" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#d7ba7d" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#b5cea8" } },
    { "scope": ["comment"], "settings": { "foreground": "#6a9955", "fontStyle": "italic" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#d4d4d4" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#d4d4d4b3" } },
    { "scope": ["meta.preprocessor"], "settings": { "foreground": "#c586c0" } },
    { "scope": ["meta.annotation"], "settings": { "foreground": "#c586c0" } },
    { "scope": ["variable"], "settings": { "foreground": "#9cdcfe" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#9cdcfe" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#569cd6" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#9cdcfe" } },
    { "scope": ["constant.character.entity"], "settings": { "foreground": "#4ec9b0" } },
    { "scope": ["entity.name.section"], "settings": { "foreground": "#4ec9b0", "fontStyle": "bold" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#569cd6", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#9cdcfe", "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#9cdcfe", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#3794ff" } },
    { "scope": ["markup.inline.raw"], "settings": { "foreground": "#b5cea8" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#b5cea8" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#f44747" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#569cd6" } }
  ]
}
