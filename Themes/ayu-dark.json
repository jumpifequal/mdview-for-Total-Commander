{
  // Ayu colour palette (MIT, github.com/ayu-theme), VS Code colour theme format. Built-in theme of Syntax.
  "name": "Ayu Dark",
  "type": "dark",
  "colors": {
    "mdview.markBackground": "#7a5d00",
    "mdview.markForeground": "#fff7cc",
    "mdview.findBackground": "#6d5200",
    "mdview.findForeground": "#fff4cb",
    "mdview.findActiveBackground": "#ffb454",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#bfbdb6",
    "focusBorder": "#e6b450",
    "editor.background": "#0b0e14",
    "editor.foreground": "#bfbdb6",
    "editor.selectionBackground": "#273747",
    "editor.lineHighlightBackground": "#6c73801a",
    "editor.findMatchHighlightBackground": "#e6b45055",
    "editorCursor.foreground": "#e6b450",
    "editorRuler.foreground": "#1b1f29",
    "editorLineNumber.foreground": "#6c738099",
    "editorLineNumber.activeForeground": "#6c7380",
    "editorBracketMatch.background": "#e6b45033",
    "editorBracketMatch.border": "#e6b45088",
    "editorWidget.background": "#0d1017",
    "editorWidget.border": "#1b1f29",
    "input.background": "#0b0e14",
    "input.border": "#1b1f29",
    "inputOption.activeBackground": "#e6b45033",
    "inputOption.activeBorder": "#e6b450",
    "textLink.foreground": "#e6b450",
    "titleBar.activeBackground": "#0d1017",
    "titleBar.activeForeground": "#bfbdb6",
    "titleBar.inactiveForeground": "#8a9199",
    "titleBar.border": "#1b1f29",
    "menu.background": "#0d1017",
    "menu.foreground": "#bfbdb6",
    "menu.selectionBackground": "#273747",
    "menu.selectionForeground": "#bfbdb6",
    "menu.separatorBackground": "#1b1f29",
    "menu.border": "#1b1f29",
    "statusBar.background": "#0d1017",
    "statusBar.foreground": "#8a9199",
    "editorGroupHeader.tabsBackground": "#0d1017",
    "tab.activeBackground": "#0b0e14",
    "tab.inactiveBackground": "#0d1017",
    "tab.hoverBackground": "#0d1017",
    "tab.activeForeground": "#bfbdb6",
    "tab.inactiveForeground": "#8a9199",
    "tab.activeBorderTop": "#e6b450",
    "tab.border": "#1b1f29",
    "minimap.background": "#0b0e14",
    "scrollbarSlider.background": "#8a919933",
    "scrollbarSlider.hoverBackground": "#8a919955",
    "scrollbarSlider.activeBackground": "#8a919977"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#636c76", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#aad94c" } },
    { "scope": ["constant.numeric", "constant", "constant.language"], "settings": { "foreground": "#d2a6ff" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#ff8f40" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#f29668" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#ffb454" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#59c2ff" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#bfbdb6" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#39bae6" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#ffb454" } },
    { "scope": ["meta.preprocessor", "keyword.control.directive"], "settings": { "foreground": "#ff8f40" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#ffb454", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#aad94c" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#d95757" } },
    { "scope": ["markup.inline.raw", "markup.raw"], "settings": { "foreground": "#aad94c" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#ffb454" } },
    { "scope": ["invalid"], "settings": { "foreground": "#d95757" } },
    // Scopes for the styles that VS Code themes usually do not have a rule for (Syntax and Synta, the Total Commander plugin, use them).
    { "scope": ["keyword.control.flow"], "settings": { "foreground": "#f29668" } },
    { "scope": ["entity.other.inherited-class"], "settings": { "foreground": "#f0db4f" } },
    { "scope": ["keyword.other.unit"], "settings": { "foreground": "#f07db8" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#95e6cb" } },
    { "scope": ["meta.annotation"], "settings": { "foreground": "#e6b673" } },
    { "scope": ["constant.character.entity"], "settings": { "foreground": "#95e6cb" } },
    { "scope": ["entity.name.section"], "settings": { "foreground": "#59c2ff", "fontStyle": "bold" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#bfbdb6b3" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#73b8ff" } }
  ]
}
