{
  // One Light, converted from Synta's own theme format. VS Code colour theme format, also used by Syntax.
  "name": "One Light",
  "type": "light",
  "colors": {
    "mdview.markBackground": "#fff59d",
    "mdview.markForeground": "#24292e",
    "mdview.findBackground": "#fff0a6",
    "mdview.findForeground": "#24292e",
    "mdview.findActiveBackground": "#ff9800",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#383a42",
    "focusBorder": "#4078f2",
    "editor.background": "#fafafa",
    "editor.foreground": "#383a42",
    "editorGutter.background": "#fafafa",
    "editorLineNumber.foreground": "#a0a1a799",
    "editorLineNumber.activeForeground": "#a0a1a7",
    "editor.lineHighlightBackground": "#a0a1a722",
    "editor.selectionBackground": "#526fff26",
    "editor.inactiveSelectionBackground": "#a0a1a733",
    "editor.findMatchBackground": "#526fff44",
    "editorIndentGuide.background1": "#a0a1a733",
    "editorCursor.foreground": "#383a42",
    "textLink.foreground": "#4078f2",
    "titleBar.activeBackground": "#f0f0f1",
    "titleBar.activeForeground": "#383a42",
    "titleBar.border": "#dfdfe0",
    "menu.background": "#fafafa",
    "menu.foreground": "#383a42",
    "menu.selectionBackground": "#e7e7e8",
    "menu.separatorBackground": "#dfdfe0",
    "statusBar.background": "#f0f0f1",
    "statusBar.foreground": "#7c7d82",
    "editorGroupHeader.tabsBackground": "#f0f0f1",
    "tab.activeBackground": "#fafafa",
    "tab.inactiveBackground": "#f0f0f1",
    "tab.hoverBackground": "#e7e7e8",
    "tab.activeForeground": "#383a42",
    "tab.inactiveForeground": "#7c7d82",
    "tab.activeBorderTop": "#4078f2",
    "tab.border": "#dfdfe0"
  },
  "tokenColors": [
    { "settings": { "foreground": "#383a42" } },
    { "scope": ["keyword"], "settings": { "foreground": "#a626a4" } },
    { "scope": ["keyword.control.flow"], "settings": { "foreground": "#a626a4" } },
    { "scope": ["entity.name.type"], "settings": { "foreground": "#c18401" } },
    { "scope": ["entity.other.inherited-class"], "settings": { "foreground": "#c18401" } },
    { "scope": ["constant.language"], "settings": { "foreground": "#986801" } },
    { "scope": ["support.function"], "settings": { "foreground": "#0184bc" } },
    { "scope": ["keyword.other.unit"], "settings": { "foreground": "#986801" } },
    { "scope": ["entity.name.function"], "settings": { "foreground": "#4078f2" } },
    { "scope": ["string"], "settings": { "foreground": "#50a14f" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#0184bc" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#986801" } },
    { "scope": ["comment"], "settings": { "foreground": "#a0a1a7", "fontStyle": "italic" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#383a42" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#383a42b3" } },
    { "scope": ["meta.preprocessor"], "settings": { "foreground": "#a626a4" } },
    { "scope": ["meta.annotation"], "settings": { "foreground": "#a626a4" } },
    { "scope": ["variable"], "settings": { "foreground": "#e45649" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#e45649" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#e45649" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#986801" } },
    { "scope": ["constant.character.entity"], "settings": { "foreground": "#e45649" } },
    { "scope": ["entity.name.section"], "settings": { "foreground": "#c18401", "fontStyle": "bold" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#e45649", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#e45649", "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#e45649", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#4078f2" } },
    { "scope": ["markup.inline.raw"], "settings": { "foreground": "#50a14f" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#50a14f" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#e45649" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#c18401" } }
  ]
}
