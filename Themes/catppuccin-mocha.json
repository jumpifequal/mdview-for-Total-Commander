{
  // Catppuccin palette (MIT, catppuccin.com), VS Code colour theme format. Built-in theme of Syntax.
  "name": "Catppuccin Mocha",
  "type": "dark",
  "colors": {
    "mdview.markBackground": "#7a5d00",
    "mdview.markForeground": "#fff7cc",
    "mdview.findBackground": "#6d5200",
    "mdview.findForeground": "#fff4cb",
    "mdview.findActiveBackground": "#ffb454",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#cdd6f4",
    "focusBorder": "#89b4fa",
    "editor.background": "#1e1e2e",
    "editor.foreground": "#cdd6f4",
    "editor.selectionBackground": "#45475a",
    "editor.lineHighlightBackground": "#31324488",
    "editor.findMatchHighlightBackground": "#89b4fa55",
    "editorCursor.foreground": "#b4befe",
    "editorRuler.foreground": "#313244",
    "editorLineNumber.foreground": "#6c7086",
    "editorLineNumber.activeForeground": "#b4befe",
    "editorBracketMatch.background": "#89b4fa33",
    "editorBracketMatch.border": "#89b4fa88",
    "editorWidget.background": "#181825",
    "editorWidget.border": "#313244",
    "input.background": "#1e1e2e",
    "input.border": "#313244",
    "inputOption.activeBackground": "#89b4fa33",
    "inputOption.activeBorder": "#89b4fa",
    "textLink.foreground": "#89b4fa",
    "titleBar.activeBackground": "#11111b",
    "titleBar.activeForeground": "#cdd6f4",
    "titleBar.inactiveForeground": "#a6adc8",
    "titleBar.border": "#313244",
    "menu.background": "#181825",
    "menu.foreground": "#cdd6f4",
    "menu.selectionBackground": "#45475a",
    "menu.selectionForeground": "#cdd6f4",
    "menu.separatorBackground": "#313244",
    "menu.border": "#313244",
    "statusBar.background": "#11111b",
    "statusBar.foreground": "#a6adc8",
    "editorGroupHeader.tabsBackground": "#11111b",
    "tab.activeBackground": "#1e1e2e",
    "tab.inactiveBackground": "#11111b",
    "tab.hoverBackground": "#181825",
    "tab.activeForeground": "#cdd6f4",
    "tab.inactiveForeground": "#a6adc8",
    "tab.activeBorderTop": "#89b4fa",
    "tab.border": "#313244",
    "minimap.background": "#1e1e2e",
    "scrollbarSlider.background": "#a6adc833",
    "scrollbarSlider.hoverBackground": "#a6adc855",
    "scrollbarSlider.activeBackground": "#a6adc877"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#9399b2", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#a6e3a1" } },
    { "scope": ["constant.numeric", "constant", "constant.language"], "settings": { "foreground": "#fab387" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#cba6f7" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#89dceb" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#89b4fa" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#f9e2af" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#cdd6f4" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#89b4fa" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#f9e2af" } },
    { "scope": ["meta.preprocessor", "keyword.control.directive"], "settings": { "foreground": "#f5c2e7" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#89b4fa", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#a6e3a1" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#f38ba8" } },
    { "scope": ["markup.inline.raw", "markup.raw"], "settings": { "foreground": "#a6e3a1" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#f9e2af" } },
    { "scope": ["invalid"], "settings": { "foreground": "#f38ba8" } },
    // Scopes for the styles that VS Code themes usually do not have a rule for (Syntax and Synta, the Total Commander plugin, use them).
    { "scope": ["keyword.control.flow"], "settings": { "foreground": "#cba6f7" } },
    { "scope": ["entity.other.inherited-class"], "settings": { "foreground": "#f9e2af" } },
    { "scope": ["keyword.other.unit"], "settings": { "foreground": "#f5c2e7" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#f5c2e7" } },
    { "scope": ["meta.annotation"], "settings": { "foreground": "#f5c2e7" } },
    { "scope": ["constant.character.entity"], "settings": { "foreground": "#94e2d5" } },
    { "scope": ["entity.name.section"], "settings": { "foreground": "#f9e2af", "fontStyle": "bold" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#cdd6f4b3" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#f9e2af" } }
  ]
}
