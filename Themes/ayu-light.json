{
  // Ayu colour palette (MIT, github.com/ayu-theme), VS Code colour theme format. Built-in theme of Syntax.
  "name": "Ayu Light",
  "type": "light",
  "colors": {
    "mdview.markBackground": "#fff59d",
    "mdview.markForeground": "#24292e",
    "mdview.findBackground": "#fff0a6",
    "mdview.findForeground": "#24292e",
    "mdview.findActiveBackground": "#ff9800",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#5c6166",
    "focusBorder": "#ff9940",
    "editor.background": "#fcfcfc",
    "editor.foreground": "#5c6166",
    "editor.selectionBackground": "#d1e4f4",
    "editor.lineHighlightBackground": "#8a91991a",
    "editor.findMatchHighlightBackground": "#ff994055",
    "editorCursor.foreground": "#ff9940",
    "editorRuler.foreground": "#e0e3e6",
    "editorLineNumber.foreground": "#8a919966",
    "editorLineNumber.activeForeground": "#8a9199",
    "editorBracketMatch.background": "#ff994033",
    "editorBracketMatch.border": "#ff994088",
    "editorWidget.background": "#f3f4f5",
    "editorWidget.border": "#e0e3e6",
    "input.background": "#fcfcfc",
    "input.border": "#e0e3e6",
    "inputOption.activeBackground": "#ff994033",
    "inputOption.activeBorder": "#ff9940",
    "textLink.foreground": "#ff9940",
    "titleBar.activeBackground": "#f3f4f5",
    "titleBar.activeForeground": "#5c6166",
    "titleBar.inactiveForeground": "#6c7680",
    "titleBar.border": "#e0e3e6",
    "menu.background": "#f3f4f5",
    "menu.foreground": "#5c6166",
    "menu.selectionBackground": "#d1e4f4",
    "menu.selectionForeground": "#5c6166",
    "menu.separatorBackground": "#e0e3e6",
    "menu.border": "#e0e3e6",
    "statusBar.background": "#f3f4f5",
    "statusBar.foreground": "#6c7680",
    "editorGroupHeader.tabsBackground": "#f3f4f5",
    "tab.activeBackground": "#fcfcfc",
    "tab.inactiveBackground": "#f3f4f5",
    "tab.hoverBackground": "#f3f4f5",
    "tab.activeForeground": "#5c6166",
    "tab.inactiveForeground": "#6c7680",
    "tab.activeBorderTop": "#ff9940",
    "tab.border": "#e0e3e6",
    "minimap.background": "#fcfcfc",
    "scrollbarSlider.background": "#6c768033",
    "scrollbarSlider.hoverBackground": "#6c768055",
    "scrollbarSlider.activeBackground": "#6c768077"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8a9199", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#86b300" } },
    { "scope": ["constant.numeric", "constant", "constant.language"], "settings": { "foreground": "#a37acc" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#fa8d3e" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#ed9366" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#f2ae49" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#399ee6" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#5c6166" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#55b4d4" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#f2ae49" } },
    { "scope": ["meta.preprocessor", "keyword.control.directive"], "settings": { "foreground": "#fa8d3e" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#f2ae49", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#86b300" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#e65050" } },
    { "scope": ["markup.inline.raw", "markup.raw"], "settings": { "foreground": "#86b300" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#f2ae49" } },
    { "scope": ["invalid"], "settings": { "foreground": "#e65050" } },
    // Scopes for the styles that VS Code themes usually do not have a rule for (Syntax and Synta, the Total Commander plugin, use them).
    { "scope": ["keyword.control.flow"], "settings": { "foreground": "#ed9366" } },
    { "scope": ["entity.other.inherited-class"], "settings": { "foreground": "#cc9a06" } },
    { "scope": ["keyword.other.unit"], "settings": { "foreground": "#d6409f" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#4cbf99" } },
    { "scope": ["meta.annotation"], "settings": { "foreground": "#e59645" } },
    { "scope": ["constant.character.entity"], "settings": { "foreground": "#4cbf99" } },
    { "scope": ["entity.name.section"], "settings": { "foreground": "#399ee6", "fontStyle": "bold" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#5c6166b3" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#478acc" } }
  ]
}
