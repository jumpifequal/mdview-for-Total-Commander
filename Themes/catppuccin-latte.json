{
  // Catppuccin palette (MIT, catppuccin.com), VS Code colour theme format. Built-in theme of Syntax.
  "name": "Catppuccin Latte",
  "type": "light",
  "colors": {
    "mdview.markBackground": "#fff59d",
    "mdview.markForeground": "#24292e",
    "mdview.findBackground": "#fff0a6",
    "mdview.findForeground": "#24292e",
    "mdview.findActiveBackground": "#ff9800",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#4c4f69",
    "focusBorder": "#1e66f5",
    "editor.background": "#eff1f5",
    "editor.foreground": "#4c4f69",
    "editor.selectionBackground": "#bcc0cc",
    "editor.lineHighlightBackground": "#ccd0da88",
    "editor.findMatchHighlightBackground": "#1e66f555",
    "editorCursor.foreground": "#7287fd",
    "editorRuler.foreground": "#ccd0da",
    "editorLineNumber.foreground": "#9ca0b0",
    "editorLineNumber.activeForeground": "#7287fd",
    "editorBracketMatch.background": "#1e66f533",
    "editorBracketMatch.border": "#1e66f588",
    "editorWidget.background": "#e6e9ef",
    "editorWidget.border": "#ccd0da",
    "input.background": "#eff1f5",
    "input.border": "#ccd0da",
    "inputOption.activeBackground": "#1e66f533",
    "inputOption.activeBorder": "#1e66f5",
    "textLink.foreground": "#1e66f5",
    "titleBar.activeBackground": "#dce0e8",
    "titleBar.activeForeground": "#4c4f69",
    "titleBar.inactiveForeground": "#6c6f85",
    "titleBar.border": "#ccd0da",
    "menu.background": "#e6e9ef",
    "menu.foreground": "#4c4f69",
    "menu.selectionBackground": "#bcc0cc",
    "menu.selectionForeground": "#4c4f69",
    "menu.separatorBackground": "#ccd0da",
    "menu.border": "#ccd0da",
    "statusBar.background": "#dce0e8",
    "statusBar.foreground": "#6c6f85",
    "editorGroupHeader.tabsBackground": "#dce0e8",
    "tab.activeBackground": "#eff1f5",
    "tab.inactiveBackground": "#dce0e8",
    "tab.hoverBackground": "#e6e9ef",
    "tab.activeForeground": "#4c4f69",
    "tab.inactiveForeground": "#6c6f85",
    "tab.activeBorderTop": "#1e66f5",
    "tab.border": "#ccd0da",
    "minimap.background": "#eff1f5",
    "scrollbarSlider.background": "#6c6f8533",
    "scrollbarSlider.hoverBackground": "#6c6f8555",
    "scrollbarSlider.activeBackground": "#6c6f8577"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#7c7f93", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#40a02b" } },
    { "scope": ["constant.numeric", "constant", "constant.language"], "settings": { "foreground": "#fe640b" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#8839ef" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#04a5e5" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#1e66f5" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#df8e1d" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#4c4f69" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#1e66f5" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#df8e1d" } },
    { "scope": ["meta.preprocessor", "keyword.control.directive"], "settings": { "foreground": "#ea76cb" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#1e66f5", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#40a02b" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#d20f39" } },
    { "scope": ["markup.inline.raw", "markup.raw"], "settings": { "foreground": "#40a02b" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#df8e1d" } },
    { "scope": ["invalid"], "settings": { "foreground": "#d20f39" } },
    // Scopes for the styles that VS Code themes usually do not have a rule for (Syntax and Synta, the Total Commander plugin, use them).
    { "scope": ["keyword.control.flow"], "settings": { "foreground": "#8839ef" } },
    { "scope": ["entity.other.inherited-class"], "settings": { "foreground": "#df8e1d" } },
    { "scope": ["keyword.other.unit"], "settings": { "foreground": "#ea76cb" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#ea76cb" } },
    { "scope": ["meta.annotation"], "settings": { "foreground": "#ea76cb" } },
    { "scope": ["constant.character.entity"], "settings": { "foreground": "#179299" } },
    { "scope": ["entity.name.section"], "settings": { "foreground": "#df8e1d", "fontStyle": "bold" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#4c4f69b3" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#df8e1d" } }
  ]
}
