{
  // Ayu Mirage Light, converted from Synta's own theme format. VS Code colour theme format, also used by Syntax.
  "name": "Ayu Mirage Light",
  "type": "light",
  "colors": {
    "mdview.markBackground": "#fff59d",
    "mdview.markForeground": "#24292e",
    "mdview.findBackground": "#fff0a6",
    "mdview.findForeground": "#24292e",
    "mdview.findActiveBackground": "#ff9800",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#3f4659",
    "focusBorder": "#55b4d4",
    "editor.background": "#e8ebf2",
    "editor.foreground": "#3f4659",
    "editorGutter.background": "#e8ebf2",
    "editorLineNumber.foreground": "#8a919966",
    "editorLineNumber.activeForeground": "#8a9199cc",
    "editor.lineHighlightBackground": "#8a91991a",
    "editor.selectionBackground": "#035bd626",
    "editor.inactiveSelectionBackground": "#8a919933",
    "editor.findMatchBackground": "#d4c4f0",
    "editorIndentGuide.background1": "#8a91992e",
    "editorCursor.foreground": "#3f4659",
    "textLink.foreground": "#55b4d4",
    "titleBar.activeBackground": "#e0e3ea",
    "titleBar.activeForeground": "#3f4659",
    "titleBar.border": "#d0d4dd",
    "menu.background": "#e8ebf2",
    "menu.foreground": "#3f4659",
    "menu.selectionBackground": "#d7dae3",
    "menu.separatorBackground": "#d0d4dd",
    "statusBar.background": "#e0e3ea",
    "statusBar.foreground": "#7a808f",
    "editorGroupHeader.tabsBackground": "#e0e3ea",
    "tab.activeBackground": "#e8ebf2",
    "tab.inactiveBackground": "#e0e3ea",
    "tab.hoverBackground": "#d7dae3",
    "tab.activeForeground": "#3f4659",
    "tab.inactiveForeground": "#7a808f",
    "tab.activeBorderTop": "#55b4d4",
    "tab.border": "#d0d4dd"
  },
  "tokenColors": [
    { "settings": { "foreground": "#3f4659" } },
    { "scope": ["keyword"], "settings": { "foreground": "#fa8d3e" } },
    { "scope": ["keyword.control.flow"], "settings": { "foreground": "#ed9366" } },
    { "scope": ["entity.name.type"], "settings": { "foreground": "#399ee6" } },
    { "scope": ["entity.other.inherited-class"], "settings": { "foreground": "#cc9a06" } },
    { "scope": ["constant.language"], "settings": { "foreground": "#a37acc" } },
    { "scope": ["support.function"], "settings": { "foreground": "#55b4d4" } },
    { "scope": ["keyword.other.unit"], "settings": { "foreground": "#d6409f" } },
    { "scope": ["entity.name.function"], "settings": { "foreground": "#f2ae49" } },
    { "scope": ["string"], "settings": { "foreground": "#86b300" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#4cbf99" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#a37acc" } },
    { "scope": ["comment"], "settings": { "foreground": "#6b7385", "fontStyle": "italic" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#6f7e91" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#3f4659b3" } },
    { "scope": ["meta.preprocessor"], "settings": { "foreground": "#e59645" } },
    { "scope": ["meta.annotation"], "settings": { "foreground": "#e59645" } },
    { "scope": ["variable"], "settings": { "foreground": "#f07171" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#55b4d4" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#55b4d4" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#f2ae49" } },
    { "scope": ["constant.character.entity"], "settings": { "foreground": "#4cbf99" } },
    { "scope": ["entity.name.section"], "settings": { "foreground": "#399ee6", "fontStyle": "bold" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#fa8d3e", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#f07171", "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#f07171", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#55b4d4" } },
    { "scope": ["markup.inline.raw"], "settings": { "foreground": "#86b300" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#6cbf43" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#ff7383" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#478acc" } }
  ]
}
