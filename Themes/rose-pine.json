{
  // Rose Pine, converted from Synta's own theme format. VS Code colour theme format, also used by Syntax.
  "name": "Rose Pine",
  "type": "dark",
  "colors": {
    "mdview.markBackground": "#7a5d00",
    "mdview.markForeground": "#fff7cc",
    "mdview.findBackground": "#6d5200",
    "mdview.findForeground": "#fff4cb",
    "mdview.findActiveBackground": "#ffb454",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#e0def4",
    "focusBorder": "#c4a7e7",
    "editor.background": "#191724",
    "editor.foreground": "#e0def4",
    "editorGutter.background": "#191724",
    "editorLineNumber.foreground": "#6e6a8699",
    "editorLineNumber.activeForeground": "#6e6a86",
    "editor.lineHighlightBackground": "#6e6a8622",
    "editor.selectionBackground": "#c4a7e740",
    "editor.inactiveSelectionBackground": "#6e6a8633",
    "editor.findMatchBackground": "#c4a7e744",
    "editorIndentGuide.background1": "#6e6a8633",
    "editorCursor.foreground": "#e0def4",
    "textLink.foreground": "#c4a7e7",
    "titleBar.activeBackground": "#23212e",
    "titleBar.activeForeground": "#e0def4",
    "titleBar.border": "#353341",
    "menu.background": "#191724",
    "menu.foreground": "#e0def4",
    "menu.selectionBackground": "#2d2b39",
    "menu.separatorBackground": "#353341",
    "statusBar.background": "#23212e",
    "statusBar.foreground": "#9a98ab",
    "editorGroupHeader.tabsBackground": "#23212e",
    "tab.activeBackground": "#191724",
    "tab.inactiveBackground": "#23212e",
    "tab.hoverBackground": "#2d2b39",
    "tab.activeForeground": "#e0def4",
    "tab.inactiveForeground": "#9a98ab",
    "tab.activeBorderTop": "#c4a7e7",
    "tab.border": "#353341"
  },
  "tokenColors": [
    { "settings": { "foreground": "#e0def4" } },
    { "scope": ["keyword"], "settings": { "foreground": "#31748f" } },
    { "scope": ["keyword.control.flow"], "settings": { "foreground": "#31748f" } },
    { "scope": ["entity.name.type"], "settings": { "foreground": "#9ccfd8" } },
    { "scope": ["entity.other.inherited-class"], "settings": { "foreground": "#f6c177" } },
    { "scope": ["constant.language"], "settings": { "foreground": "#ebbcba" } },
    { "scope": ["support.function"], "settings": { "foreground": "#ebbcba" } },
    { "scope": ["keyword.other.unit"], "settings": { "foreground": "#eb6f92" } },
    { "scope": ["entity.name.function"], "settings": { "foreground": "#ebbcba" } },
    { "scope": ["string"], "settings": { "foreground": "#f6c177" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#31748f" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#ebbcba" } },
    { "scope": ["comment"], "settings": { "foreground": "#6e6a86", "fontStyle": "italic" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#908caa" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#e0def4b3" } },
    { "scope": ["meta.preprocessor"], "settings": { "foreground": "#c4a7e7" } },
    { "scope": ["meta.annotation"], "settings": { "foreground": "#c4a7e7" } },
    { "scope": ["variable"], "settings": { "foreground": "#e0def4" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#ebbcba" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#31748f" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#c4a7e7" } },
    { "scope": ["constant.character.entity"], "settings": { "foreground": "#9ccfd8" } },
    { "scope": ["entity.name.section"], "settings": { "foreground": "#9ccfd8", "fontStyle": "bold" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#9ccfd8", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#e0def4", "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#e0def4", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#c4a7e7" } },
    { "scope": ["markup.inline.raw"], "settings": { "foreground": "#9ccfd8" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#9ccfd8" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#eb6f92" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#f6c177" } }
  ]
}
