{
  // One Dark, converted from Synta's own theme format. VS Code colour theme format, also used by Syntax.
  "name": "One Dark",
  "type": "dark",
  "colors": {
    "mdview.markBackground": "#7a5d00",
    "mdview.markForeground": "#fff7cc",
    "mdview.findBackground": "#6d5200",
    "mdview.findForeground": "#fff4cb",
    "mdview.findActiveBackground": "#ffb454",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#abb2bf",
    "focusBorder": "#61afef",
    "editor.background": "#282c34",
    "editor.foreground": "#abb2bf",
    "editorGutter.background": "#282c34",
    "editorLineNumber.foreground": "#5c637099",
    "editorLineNumber.activeForeground": "#5c6370",
    "editor.lineHighlightBackground": "#5c637022",
    "editor.selectionBackground": "#528bff40",
    "editor.inactiveSelectionBackground": "#5c637033",
    "editor.findMatchBackground": "#528bff44",
    "editorIndentGuide.background1": "#5c637033",
    "editorCursor.foreground": "#abb2bf",
    "textLink.foreground": "#61afef",
    "titleBar.activeBackground": "#2f333b",
    "titleBar.activeForeground": "#abb2bf",
    "titleBar.border": "#3a3f47",
    "menu.background": "#282c34",
    "menu.foreground": "#abb2bf",
    "menu.selectionBackground": "#353942",
    "menu.separatorBackground": "#3a3f47",
    "statusBar.background": "#2f333b",
    "statusBar.foreground": "#7d838e",
    "editorGroupHeader.tabsBackground": "#2f333b",
    "tab.activeBackground": "#282c34",
    "tab.inactiveBackground": "#2f333b",
    "tab.hoverBackground": "#353942",
    "tab.activeForeground": "#abb2bf",
    "tab.inactiveForeground": "#7d838e",
    "tab.activeBorderTop": "#61afef",
    "tab.border": "#3a3f47"
  },
  "tokenColors": [
    { "settings": { "foreground": "#abb2bf" } },
    { "scope": ["keyword"], "settings": { "foreground": "#c678dd" } },
    { "scope": ["keyword.control.flow"], "settings": { "foreground": "#c678dd" } },
    { "scope": ["entity.name.type"], "settings": { "foreground": "#e5c07b" } },
    { "scope": ["entity.other.inherited-class"], "settings": { "foreground": "#e5c07b" } },
    { "scope": ["constant.language"], "settings": { "foreground": "#d19a66" } },
    { "scope": ["support.function"], "settings": { "foreground": "#56b6c2" } },
    { "scope": ["keyword.other.unit"], "settings": { "foreground": "#d19a66" } },
    { "scope": ["entity.name.function"], "settings": { "foreground": "#61afef" } },
    { "scope": ["string"], "settings": { "foreground": "#98c379" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#56b6c2" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#d19a66" } },
    { "scope": ["comment"], "settings": { "foreground": "#5c6370", "fontStyle": "italic" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#56b6c2" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#abb2bfb3" } },
    { "scope": ["meta.preprocessor"], "settings": { "foreground": "#c678dd" } },
    { "scope": ["meta.annotation"], "settings": { "foreground": "#c678dd" } },
    { "scope": ["variable"], "settings": { "foreground": "#e06c75" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#e06c75" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#e06c75" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#d19a66" } },
    { "scope": ["constant.character.entity"], "settings": { "foreground": "#e06c75" } },
    { "scope": ["entity.name.section"], "settings": { "foreground": "#e5c07b", "fontStyle": "bold" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#e06c75", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#e06c75", "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#e06c75", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#61afef" } },
    { "scope": ["markup.inline.raw"], "settings": { "foreground": "#98c379" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#98c379" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#e06c75" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#e5c07b" } }
  ]
}
