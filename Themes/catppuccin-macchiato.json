{
  // Catppuccin palette (MIT, catppuccin.com), VS Code colour theme format. Built-in theme of Syntax.
  "name": "Catppuccin Macchiato",
  "type": "dark",
  "colors": {
    "mdview.markBackground": "#7a5d00",
    "mdview.markForeground": "#fff7cc",
    "mdview.findBackground": "#6d5200",
    "mdview.findForeground": "#fff4cb",
    "mdview.findActiveBackground": "#ffb454",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#cad3f5",
    "focusBorder": "#8aadf4",
    "editor.background": "#24273a",
    "editor.foreground": "#cad3f5",
    "editor.selectionBackground": "#494d64",
    "editor.lineHighlightBackground": "#363a4f88",
    "editor.findMatchHighlightBackground": "#8aadf455",
    "editorCursor.foreground": "#b7bdf8",
    "editorRuler.foreground": "#363a4f",
    "editorLineNumber.foreground": "#6e738d",
    "editorLineNumber.activeForeground": "#b7bdf8",
    "editorBracketMatch.background": "#8aadf433",
    "editorBracketMatch.border": "#8aadf488",
    "editorWidget.background": "#1e2030",
    "editorWidget.border": "#363a4f",
    "input.background": "#24273a",
    "input.border": "#363a4f",
    "inputOption.activeBackground": "#8aadf433",
    "inputOption.activeBorder": "#8aadf4",
    "textLink.foreground": "#8aadf4",
    "titleBar.activeBackground": "#181926",
    "titleBar.activeForeground": "#cad3f5",
    "titleBar.inactiveForeground": "#a5adcb",
    "titleBar.border": "#363a4f",
    "menu.background": "#1e2030",
    "menu.foreground": "#cad3f5",
    "menu.selectionBackground": "#494d64",
    "menu.selectionForeground": "#cad3f5",
    "menu.separatorBackground": "#363a4f",
    "menu.border": "#363a4f",
    "statusBar.background": "#181926",
    "statusBar.foreground": "#a5adcb",
    "editorGroupHeader.tabsBackground": "#181926",
    "tab.activeBackground": "#24273a",
    "tab.inactiveBackground": "#181926",
    "tab.hoverBackground": "#1e2030",
    "tab.activeForeground": "#cad3f5",
    "tab.inactiveForeground": "#a5adcb",
    "tab.activeBorderTop": "#8aadf4",
    "tab.border": "#363a4f",
    "minimap.background": "#24273a",
    "scrollbarSlider.background": "#a5adcb33",
    "scrollbarSlider.hoverBackground": "#a5adcb55",
    "scrollbarSlider.activeBackground": "#a5adcb77"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#939ab7", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#a6da95" } },
    { "scope": ["constant.numeric", "constant", "constant.language"], "settings": { "foreground": "#f5a97f" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#c6a0f6" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#91d7e3" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#8aadf4" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#eed49f" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#cad3f5" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#8aadf4" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#eed49f" } },
    { "scope": ["meta.preprocessor", "keyword.control.directive"], "settings": { "foreground": "#f5bde6" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#8aadf4", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#a6da95" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#ed8796" } },
    { "scope": ["markup.inline.raw", "markup.raw"], "settings": { "foreground": "#a6da95" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#eed49f" } },
    { "scope": ["invalid"], "settings": { "foreground": "#ed8796" } }
  ]
}
