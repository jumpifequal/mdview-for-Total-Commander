{
  // Tokyo Night palette (MIT, github.com/folke/tokyonight.nvim), VS Code colour theme format. Built-in theme of Syntax.
  "name": "Tokyo Night Moon",
  "type": "dark",
  "colors": {
    "mdview.markBackground": "#7a5d00",
    "mdview.markForeground": "#fff7cc",
    "mdview.findBackground": "#6d5200",
    "mdview.findForeground": "#fff4cb",
    "mdview.findActiveBackground": "#ffb454",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#c8d3f5",
    "focusBorder": "#82aaff",
    "editor.background": "#222436",
    "editor.foreground": "#c8d3f5",
    "editor.selectionBackground": "#2d3f76",
    "editor.lineHighlightBackground": "#2f334d",
    "editor.findMatchHighlightBackground": "#82aaff55",
    "editorCursor.foreground": "#c8d3f5",
    "editorRuler.foreground": "#1b1d2b",
    "editorLineNumber.foreground": "#3b4261",
    "editorLineNumber.activeForeground": "#737aa2",
    "editorBracketMatch.background": "#82aaff33",
    "editorBracketMatch.border": "#82aaff88",
    "editorWidget.background": "#1e2030",
    "editorWidget.border": "#1b1d2b",
    "input.background": "#222436",
    "input.border": "#1b1d2b",
    "inputOption.activeBackground": "#82aaff33",
    "inputOption.activeBorder": "#82aaff",
    "textLink.foreground": "#82aaff",
    "titleBar.activeBackground": "#1e2030",
    "titleBar.activeForeground": "#c8d3f5",
    "titleBar.inactiveForeground": "#828bb8",
    "titleBar.border": "#1b1d2b",
    "menu.background": "#1e2030",
    "menu.foreground": "#c8d3f5",
    "menu.selectionBackground": "#2d3f76",
    "menu.selectionForeground": "#c8d3f5",
    "menu.separatorBackground": "#1b1d2b",
    "menu.border": "#1b1d2b",
    "statusBar.background": "#1e2030",
    "statusBar.foreground": "#828bb8",
    "editorGroupHeader.tabsBackground": "#1e2030",
    "tab.activeBackground": "#222436",
    "tab.inactiveBackground": "#1e2030",
    "tab.hoverBackground": "#1e2030",
    "tab.activeForeground": "#c8d3f5",
    "tab.inactiveForeground": "#828bb8",
    "tab.activeBorderTop": "#82aaff",
    "tab.border": "#1b1d2b",
    "minimap.background": "#222436",
    "scrollbarSlider.background": "#828bb833",
    "scrollbarSlider.hoverBackground": "#828bb855",
    "scrollbarSlider.activeBackground": "#828bb877"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#636da6", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#c3e88d" } },
    { "scope": ["constant.numeric", "constant", "constant.language"], "settings": { "foreground": "#ff966c" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#c099ff" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#89ddff" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#82aaff" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#65bcff" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#c8d3f5" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#ff757f" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#c099ff" } },
    { "scope": ["meta.preprocessor", "keyword.control.directive"], "settings": { "foreground": "#c099ff" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#82aaff", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#c3e88d" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#c53b53" } },
    { "scope": ["markup.inline.raw", "markup.raw"], "settings": { "foreground": "#c3e88d" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#c099ff" } },
    { "scope": ["invalid"], "settings": { "foreground": "#c53b53" } }
  ]
}
