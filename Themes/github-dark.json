{
  // GitHub dark default palette (Primer colours), VS Code colour theme format. Built-in standard theme of Syntax.
  "name": "GitHub Dark",
  "type": "dark",
  "colors": {
    "mdview.markBackground": "#7a5d00",
    "mdview.markForeground": "#fff7cc",
    "mdview.findBackground": "#6d5200",
    "mdview.findForeground": "#fff4cb",
    "mdview.findActiveBackground": "#ffb454",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#e6edf3",
    "focusBorder": "#1f6feb",
    "editor.background": "#0d1117",
    "editor.foreground": "#e6edf3",
    "editor.selectionBackground": "#3392ff44",
    "editor.lineHighlightBackground": "#6e76811a",
    "editorCursor.foreground": "#2f81f7",
    "editorRuler.foreground": "#21262d",
    "textLink.foreground": "#2f81f7",
    "titleBar.activeBackground": "#010409",
    "titleBar.activeForeground": "#e6edf3",
    "titleBar.border": "#30363d",
    "menu.background": "#161b22",
    "menu.foreground": "#e6edf3",
    "menu.selectionBackground": "#6e768133",
    "menu.separatorBackground": "#30363d",
    "statusBar.background": "#010409",
    "statusBar.foreground": "#8b949e",
    "editorGroupHeader.tabsBackground": "#010409",
    "tab.activeBackground": "#0d1117",
    "tab.inactiveBackground": "#010409",
    "tab.hoverBackground": "#161b22",
    "tab.activeForeground": "#e6edf3",
    "tab.inactiveForeground": "#8b949e",
    "tab.activeBorderTop": "#f78166",
    "tab.border": "#30363d"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8b949e", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#a5d6ff" } },
    { "scope": ["constant.numeric", "constant", "constant.language"], "settings": { "foreground": "#79c0ff" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#ff7b72" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#ff7b72" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#d2a8ff" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#ffa657" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#ffa657" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#7ee787" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#79c0ff" } },
    { "scope": ["meta.preprocessor", "keyword.control.directive"], "settings": { "foreground": "#e3b341" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#79c0ff", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#7ee787" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#ffa198" } },
    { "scope": ["markup.inline.raw", "markup.raw"], "settings": { "foreground": "#a5d6ff" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#79c0ff" } },
    { "scope": ["invalid"], "settings": { "foreground": "#ffa198" } },
    // Scopes for the styles that VS Code themes usually do not have a rule for (Syntax and Synta, the Total Commander plugin, use them).
    { "scope": ["keyword.control.flow"], "settings": { "foreground": "#ff7b72" } },
    { "scope": ["entity.other.inherited-class"], "settings": { "foreground": "#ffa657" } },
    { "scope": ["keyword.other.unit"], "settings": { "foreground": "#d2a8ff" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#79c0ff" } },
    { "scope": ["meta.annotation"], "settings": { "foreground": "#ff7b72" } },
    { "scope": ["constant.character.entity"], "settings": { "foreground": "#ffa657" } },
    { "scope": ["entity.name.section"], "settings": { "foreground": "#ffa657", "fontStyle": "bold" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#c9d1d9b3" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#e3b341" } }
  ]
}
