{
  // Tokyo Night palette (MIT, github.com/folke/tokyonight.nvim), VS Code colour theme format. Built-in theme of Syntax.
  "name": "Tokyo Night Light",
  "type": "light",
  "colors": {
    "mdview.markBackground": "#fff59d",
    "mdview.markForeground": "#24292e",
    "mdview.findBackground": "#fff0a6",
    "mdview.findForeground": "#24292e",
    "mdview.findActiveBackground": "#ff9800",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#3760bf",
    "focusBorder": "#2e7de9",
    "editor.background": "#e1e2e7",
    "editor.foreground": "#3760bf",
    "editor.selectionBackground": "#b7c1e3",
    "editor.lineHighlightBackground": "#cbccd1",
    "editor.findMatchHighlightBackground": "#2e7de955",
    "editorCursor.foreground": "#3760bf",
    "editorRuler.foreground": "#b4b5b9",
    "editorLineNumber.foreground": "#b3b8d1",
    "editorLineNumber.activeForeground": "#68709a",
    "editorBracketMatch.background": "#2e7de933",
    "editorBracketMatch.border": "#2e7de988",
    "editorWidget.background": "#d0d5e3",
    "editorWidget.border": "#b4b5b9",
    "input.background": "#e1e2e7",
    "input.border": "#b4b5b9",
    "inputOption.activeBackground": "#2e7de933",
    "inputOption.activeBorder": "#2e7de9",
    "textLink.foreground": "#2e7de9",
    "titleBar.activeBackground": "#d0d5e3",
    "titleBar.activeForeground": "#3760bf",
    "titleBar.inactiveForeground": "#6172b0",
    "titleBar.border": "#b4b5b9",
    "menu.background": "#d0d5e3",
    "menu.foreground": "#3760bf",
    "menu.selectionBackground": "#b7c1e3",
    "menu.selectionForeground": "#3760bf",
    "menu.separatorBackground": "#b4b5b9",
    "menu.border": "#b4b5b9",
    "statusBar.background": "#d0d5e3",
    "statusBar.foreground": "#6172b0",
    "editorGroupHeader.tabsBackground": "#d0d5e3",
    "tab.activeBackground": "#e1e2e7",
    "tab.inactiveBackground": "#d0d5e3",
    "tab.hoverBackground": "#d0d5e3",
    "tab.activeForeground": "#3760bf",
    "tab.inactiveForeground": "#6172b0",
    "tab.activeBorderTop": "#2e7de9",
    "tab.border": "#b4b5b9",
    "minimap.background": "#e1e2e7",
    "scrollbarSlider.background": "#6172b033",
    "scrollbarSlider.hoverBackground": "#6172b055",
    "scrollbarSlider.activeBackground": "#6172b077"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#848cb5", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#587539" } },
    { "scope": ["constant.numeric", "constant", "constant.language"], "settings": { "foreground": "#b15c00" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#9854f1" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#006a83" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#2e7de9" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#007197" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#3760bf" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#f52a65" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#9854f1" } },
    { "scope": ["meta.preprocessor", "keyword.control.directive"], "settings": { "foreground": "#9854f1" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#2e7de9", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#587539" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#c64343" } },
    { "scope": ["markup.inline.raw", "markup.raw"], "settings": { "foreground": "#587539" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#9854f1" } },
    { "scope": ["invalid"], "settings": { "foreground": "#c64343" } }
  ]
}
