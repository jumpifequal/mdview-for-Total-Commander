{
  // Visual Studio Light, converted from Synta's own theme format. VS Code colour theme format, also used by Syntax.
  "name": "Visual Studio Light",
  "type": "light",
  "colors": {
    "mdview.markBackground": "#fff59d",
    "mdview.markForeground": "#24292e",
    "mdview.findBackground": "#fff0a6",
    "mdview.findForeground": "#24292e",
    "mdview.findActiveBackground": "#ff9800",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#000000",
    "focusBorder": "#0000ff",
    "editor.background": "#ffffff",
    "editor.foreground": "#000000",
    "editorGutter.background": "#ffffff",
    "editorLineNumber.foreground": "#23789399",
    "editorLineNumber.activeForeground": "#237893",
    "editor.lineHighlightBackground": "#23789322",
    "editor.selectionBackground": "#add6ff",
    "editor.selectionHighlightBackground": "#add6ff80",
    "editor.inactiveSelectionBackground": "#e5ebf1",
    "editor.findMatchBackground": "#a8ac94",
    "editorIndentGuide.background1": "#23789333",
    "editorCursor.foreground": "#000000",
    "textLink.foreground": "#0000ff",
    "titleBar.activeBackground": "#f2f2f2",
    "titleBar.activeForeground": "#000000",
    "titleBar.border": "#dbdbdb",
    "menu.background": "#ffffff",
    "menu.foreground": "#000000",
    "menu.selectionBackground": "#e6e6e6",
    "menu.separatorBackground": "#dbdbdb",
    "statusBar.background": "#f2f2f2",
    "statusBar.foreground": "#595959",
    "editorGroupHeader.tabsBackground": "#f2f2f2",
    "tab.activeBackground": "#ffffff",
    "tab.inactiveBackground": "#f2f2f2",
    "tab.hoverBackground": "#e6e6e6",
    "tab.activeForeground": "#000000",
    "tab.inactiveForeground": "#595959",
    "tab.activeBorderTop": "#0000ff",
    "tab.border": "#dbdbdb"
  },
  "tokenColors": [
    { "settings": { "foreground": "#000000" } },
    { "scope": ["keyword"], "settings": { "foreground": "#0000ff" } },
    { "scope": ["keyword.control.flow"], "settings": { "foreground": "#af00db" } },
    { "scope": ["entity.name.type"], "settings": { "foreground": "#267f99" } },
    { "scope": ["entity.other.inherited-class"], "settings": { "foreground": "#267f99" } },
    { "scope": ["constant.language"], "settings": { "foreground": "#0070c1" } },
    { "scope": ["support.function"], "settings": { "foreground": "#001080" } },
    { "scope": ["keyword.other.unit"], "settings": { "foreground": "#098658" } },
    { "scope": ["entity.name.function"], "settings": { "foreground": "#795e26" } },
    { "scope": ["string"], "settings": { "foreground": "#a31515" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#ee0000" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#098658" } },
    { "scope": ["comment"], "settings": { "foreground": "#008000", "fontStyle": "italic" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#000000" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#000000b3" } },
    { "scope": ["meta.preprocessor"], "settings": { "foreground": "#af00db" } },
    { "scope": ["meta.annotation"], "settings": { "foreground": "#af00db" } },
    { "scope": ["variable"], "settings": { "foreground": "#001080" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#0451a5" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#800000" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#e50000" } },
    { "scope": ["constant.character.entity"], "settings": { "foreground": "#267f99" } },
    { "scope": ["entity.name.section"], "settings": { "foreground": "#267f99", "fontStyle": "bold" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#0000ff", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#001080", "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#001080", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#0000ff" } },
    { "scope": ["markup.inline.raw"], "settings": { "foreground": "#098658" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#098658" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#a31515" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#0451a5" } }
  ]
}
