{
  // Gruvbox Light, converted from Synta's own theme format. VS Code colour theme format, also used by Syntax.
  "name": "Gruvbox Light",
  "type": "light",
  "colors": {
    "mdview.markBackground": "#fff59d",
    "mdview.markForeground": "#24292e",
    "mdview.findBackground": "#fff0a6",
    "mdview.findForeground": "#24292e",
    "mdview.findActiveBackground": "#ff9800",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#3c3836",
    "focusBorder": "#076678",
    "editor.background": "#fbf1c7",
    "editor.foreground": "#3c3836",
    "editorGutter.background": "#fbf1c7",
    "editorLineNumber.foreground": "#92837499",
    "editorLineNumber.activeForeground": "#928374",
    "editor.lineHighlightBackground": "#92837422",
    "editor.selectionBackground": "#45858826",
    "editor.inactiveSelectionBackground": "#92837433",
    "editor.findMatchBackground": "#45858844",
    "editorIndentGuide.background1": "#92837433",
    "editorCursor.foreground": "#3c3836",
    "textLink.foreground": "#076678",
    "titleBar.activeBackground": "#f1e8c0",
    "titleBar.activeForeground": "#3c3836",
    "titleBar.border": "#e0d7b3",
    "menu.background": "#fbf1c7",
    "menu.foreground": "#3c3836",
    "menu.selectionBackground": "#e8deb8",
    "menu.separatorBackground": "#e0d7b3",
    "statusBar.background": "#f1e8c0",
    "statusBar.foreground": "#7f7969",
    "editorGroupHeader.tabsBackground": "#f1e8c0",
    "tab.activeBackground": "#fbf1c7",
    "tab.inactiveBackground": "#f1e8c0",
    "tab.hoverBackground": "#e8deb8",
    "tab.activeForeground": "#3c3836",
    "tab.inactiveForeground": "#7f7969",
    "tab.activeBorderTop": "#076678",
    "tab.border": "#e0d7b3"
  },
  "tokenColors": [
    { "settings": { "foreground": "#3c3836" } },
    { "scope": ["keyword"], "settings": { "foreground": "#9d0006" } },
    { "scope": ["keyword.control.flow"], "settings": { "foreground": "#af3a03" } },
    { "scope": ["entity.name.type"], "settings": { "foreground": "#b57614" } },
    { "scope": ["entity.other.inherited-class"], "settings": { "foreground": "#b57614" } },
    { "scope": ["constant.language"], "settings": { "foreground": "#8f3f71" } },
    { "scope": ["support.function"], "settings": { "foreground": "#427b58" } },
    { "scope": ["keyword.other.unit"], "settings": { "foreground": "#8f3f71" } },
    { "scope": ["entity.name.function"], "settings": { "foreground": "#79740e" } },
    { "scope": ["string"], "settings": { "foreground": "#79740e" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#af3a03" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#8f3f71" } },
    { "scope": ["comment"], "settings": { "foreground": "#928374", "fontStyle": "italic" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#427b58" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#3c3836b3" } },
    { "scope": ["meta.preprocessor"], "settings": { "foreground": "#af3a03" } },
    { "scope": ["meta.annotation"], "settings": { "foreground": "#af3a03" } },
    { "scope": ["variable"], "settings": { "foreground": "#076678" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#076678" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#9d0006" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#79740e" } },
    { "scope": ["constant.character.entity"], "settings": { "foreground": "#b57614" } },
    { "scope": ["entity.name.section"], "settings": { "foreground": "#b57614", "fontStyle": "bold" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#b57614", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#076678", "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#076678", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#076678" } },
    { "scope": ["markup.inline.raw"], "settings": { "foreground": "#79740e" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#79740e" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#9d0006" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#b57614" } }
  ]
}
