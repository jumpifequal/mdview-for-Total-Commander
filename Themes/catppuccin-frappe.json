{
  // Catppuccin palette (MIT, catppuccin.com), VS Code colour theme format. Built-in theme of Syntax.
  "name": "Catppuccin Frappé",
  "type": "dark",
  "colors": {
    "mdview.markBackground": "#7a5d00",
    "mdview.markForeground": "#fff7cc",
    "mdview.findBackground": "#6d5200",
    "mdview.findForeground": "#fff4cb",
    "mdview.findActiveBackground": "#ffb454",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#c6d0f5",
    "focusBorder": "#8caaee",
    "editor.background": "#303446",
    "editor.foreground": "#c6d0f5",
    "editor.selectionBackground": "#51576d",
    "editor.lineHighlightBackground": "#41455988",
    "editor.findMatchHighlightBackground": "#8caaee55",
    "editorCursor.foreground": "#babbf1",
    "editorRuler.foreground": "#414559",
    "editorLineNumber.foreground": "#737994",
    "editorLineNumber.activeForeground": "#babbf1",
    "editorBracketMatch.background": "#8caaee33",
    "editorBracketMatch.border": "#8caaee88",
    "editorWidget.background": "#292c3c",
    "editorWidget.border": "#414559",
    "input.background": "#303446",
    "input.border": "#414559",
    "inputOption.activeBackground": "#8caaee33",
    "inputOption.activeBorder": "#8caaee",
    "textLink.foreground": "#8caaee",
    "titleBar.activeBackground": "#232634",
    "titleBar.activeForeground": "#c6d0f5",
    "titleBar.inactiveForeground": "#a5adce",
    "titleBar.border": "#414559",
    "menu.background": "#292c3c",
    "menu.foreground": "#c6d0f5",
    "menu.selectionBackground": "#51576d",
    "menu.selectionForeground": "#c6d0f5",
    "menu.separatorBackground": "#414559",
    "menu.border": "#414559",
    "statusBar.background": "#232634",
    "statusBar.foreground": "#a5adce",
    "editorGroupHeader.tabsBackground": "#232634",
    "tab.activeBackground": "#303446",
    "tab.inactiveBackground": "#232634",
    "tab.hoverBackground": "#292c3c",
    "tab.activeForeground": "#c6d0f5",
    "tab.inactiveForeground": "#a5adce",
    "tab.activeBorderTop": "#8caaee",
    "tab.border": "#414559",
    "minimap.background": "#303446",
    "scrollbarSlider.background": "#a5adce33",
    "scrollbarSlider.hoverBackground": "#a5adce55",
    "scrollbarSlider.activeBackground": "#a5adce77"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#949cbb", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#a6d189" } },
    { "scope": ["constant.numeric", "constant", "constant.language"], "settings": { "foreground": "#ef9f76" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#ca9ee6" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#99d1db" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#8caaee" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#e5c890" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#c6d0f5" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#8caaee" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#e5c890" } },
    { "scope": ["meta.preprocessor", "keyword.control.directive"], "settings": { "foreground": "#f4b8e4" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#8caaee", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#a6d189" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#e78284" } },
    { "scope": ["markup.inline.raw", "markup.raw"], "settings": { "foreground": "#a6d189" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#e5c890" } },
    { "scope": ["invalid"], "settings": { "foreground": "#e78284" } }
  ]
}
