{
  // Gruvbox Dark, converted from Synta's own theme format. VS Code colour theme format, also used by Syntax.
  "name": "Gruvbox Dark",
  "type": "dark",
  "colors": {
    "mdview.markBackground": "#7a5d00",
    "mdview.markForeground": "#fff7cc",
    "mdview.findBackground": "#6d5200",
    "mdview.findForeground": "#fff4cb",
    "mdview.findActiveBackground": "#ffb454",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#ebdbb2",
    "focusBorder": "#83a598",
    "editor.background": "#282828",
    "editor.foreground": "#ebdbb2",
    "editorGutter.background": "#282828",
    "editorLineNumber.foreground": "#92837499",
    "editorLineNumber.activeForeground": "#928374",
    "editor.lineHighlightBackground": "#92837422",
    "editor.selectionBackground": "#83a59840",
    "editor.inactiveSelectionBackground": "#92837433",
    "editor.findMatchBackground": "#83a59844",
    "editorIndentGuide.background1": "#92837433",
    "editorCursor.foreground": "#ebdbb2",
    "textLink.foreground": "#83a598",
    "titleBar.activeBackground": "#32312f",
    "titleBar.activeForeground": "#ebdbb2",
    "titleBar.border": "#43413b",
    "menu.background": "#282828",
    "menu.foreground": "#ebdbb2",
    "menu.selectionBackground": "#3c3a36",
    "menu.separatorBackground": "#43413b",
    "statusBar.background": "#32312f",
    "statusBar.foreground": "#a79c82",
    "editorGroupHeader.tabsBackground": "#32312f",
    "tab.activeBackground": "#282828",
    "tab.inactiveBackground": "#32312f",
    "tab.hoverBackground": "#3c3a36",
    "tab.activeForeground": "#ebdbb2",
    "tab.inactiveForeground": "#a79c82",
    "tab.activeBorderTop": "#83a598",
    "tab.border": "#43413b"
  },
  "tokenColors": [
    { "settings": { "foreground": "#ebdbb2" } },
    { "scope": ["keyword"], "settings": { "foreground": "#fb4934" } },
    { "scope": ["keyword.control.flow"], "settings": { "foreground": "#fe8019" } },
    { "scope": ["entity.name.type"], "settings": { "foreground": "#fabd2f" } },
    { "scope": ["entity.other.inherited-class"], "settings": { "foreground": "#fabd2f" } },
    { "scope": ["constant.language"], "settings": { "foreground": "#d3869b" } },
    { "scope": ["support.function"], "settings": { "foreground": "#8ec07c" } },
    { "scope": ["keyword.other.unit"], "settings": { "foreground": "#d3869b" } },
    { "scope": ["entity.name.function"], "settings": { "foreground": "#b8bb26" } },
    { "scope": ["string"], "settings": { "foreground": "#b8bb26" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#fe8019" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#d3869b" } },
    { "scope": ["comment"], "settings": { "foreground": "#928374", "fontStyle": "italic" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#8ec07c" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#ebdbb2b3" } },
    { "scope": ["meta.preprocessor"], "settings": { "foreground": "#fe8019" } },
    { "scope": ["meta.annotation"], "settings": { "foreground": "#fe8019" } },
    { "scope": ["variable"], "settings": { "foreground": "#83a598" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#83a598" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#fb4934" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#b8bb26" } },
    { "scope": ["constant.character.entity"], "settings": { "foreground": "#fabd2f" } },
    { "scope": ["entity.name.section"], "settings": { "foreground": "#fabd2f", "fontStyle": "bold" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#fabd2f", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#83a598", "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#83a598", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#83a598" } },
    { "scope": ["markup.inline.raw"], "settings": { "foreground": "#b8bb26" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#b8bb26" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#fb4934" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#fabd2f" } }
  ]
}
