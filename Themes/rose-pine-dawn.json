{
  // Rose Pine Dawn, converted from Synta's own theme format. VS Code colour theme format, also used by Syntax.
  "name": "Rose Pine Dawn",
  "type": "light",
  "colors": {
    "mdview.markBackground": "#fff59d",
    "mdview.markForeground": "#24292e",
    "mdview.findBackground": "#fff0a6",
    "mdview.findForeground": "#24292e",
    "mdview.findActiveBackground": "#ff9800",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#575279",
    "focusBorder": "#907aa9",
    "editor.background": "#faf4ed",
    "editor.foreground": "#575279",
    "editorGutter.background": "#faf4ed",
    "editorLineNumber.foreground": "#9893a599",
    "editorLineNumber.activeForeground": "#9893a5",
    "editor.lineHighlightBackground": "#9893a522",
    "editor.selectionBackground": "#907aa926",
    "editor.inactiveSelectionBackground": "#9893a533",
    "editor.findMatchBackground": "#907aa944",
    "editorIndentGuide.background1": "#9893a533",
    "editorCursor.foreground": "#575279",
    "textLink.foreground": "#907aa9",
    "titleBar.activeBackground": "#f2ece7",
    "titleBar.activeForeground": "#575279",
    "titleBar.border": "#e3dddd",
    "menu.background": "#faf4ed",
    "menu.foreground": "#575279",
    "menu.selectionBackground": "#eae4e1",
    "menu.separatorBackground": "#e3dddd",
    "statusBar.background": "#f2ece7",
    "statusBar.foreground": "#908ba2",
    "editorGroupHeader.tabsBackground": "#f2ece7",
    "tab.activeBackground": "#faf4ed",
    "tab.inactiveBackground": "#f2ece7",
    "tab.hoverBackground": "#eae4e1",
    "tab.activeForeground": "#575279",
    "tab.inactiveForeground": "#908ba2",
    "tab.activeBorderTop": "#907aa9",
    "tab.border": "#e3dddd"
  },
  "tokenColors": [
    { "settings": { "foreground": "#575279" } },
    { "scope": ["keyword"], "settings": { "foreground": "#286983" } },
    { "scope": ["keyword.control.flow"], "settings": { "foreground": "#286983" } },
    { "scope": ["entity.name.type"], "settings": { "foreground": "#56949f" } },
    { "scope": ["entity.other.inherited-class"], "settings": { "foreground": "#ea9d34" } },
    { "scope": ["constant.language"], "settings": { "foreground": "#d7827e" } },
    { "scope": ["support.function"], "settings": { "foreground": "#d7827e" } },
    { "scope": ["keyword.other.unit"], "settings": { "foreground": "#b4637a" } },
    { "scope": ["entity.name.function"], "settings": { "foreground": "#d7827e" } },
    { "scope": ["string"], "settings": { "foreground": "#ea9d34" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#286983" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#d7827e" } },
    { "scope": ["comment"], "settings": { "foreground": "#9893a5", "fontStyle": "italic" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#797593" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#575279b3" } },
    { "scope": ["meta.preprocessor"], "settings": { "foreground": "#907aa9" } },
    { "scope": ["meta.annotation"], "settings": { "foreground": "#907aa9" } },
    { "scope": ["variable"], "settings": { "foreground": "#575279" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#d7827e" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#286983" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#907aa9" } },
    { "scope": ["constant.character.entity"], "settings": { "foreground": "#56949f" } },
    { "scope": ["entity.name.section"], "settings": { "foreground": "#56949f", "fontStyle": "bold" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#56949f", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#575279", "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#575279", "fontStyle": "bold" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#907aa9" } },
    { "scope": ["markup.inline.raw"], "settings": { "foreground": "#56949f" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#56949f" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#b4637a" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#ea9d34" } }
  ]
}
