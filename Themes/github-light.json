{
  // GitHub light default palette (Primer colours), VS Code colour theme format. Built-in standard theme of Syntax.
  "name": "GitHub Light",
  "type": "light",
  "colors": {
    "mdview.markBackground": "#fff59d",
    "mdview.markForeground": "#24292e",
    "mdview.findBackground": "#fff0a6",
    "mdview.findForeground": "#24292e",
    "mdview.findActiveBackground": "#ff9800",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#1f2328",
    "focusBorder": "#0969da",
    "editor.background": "#ffffff",
    "editor.foreground": "#1f2328",
    "editor.selectionBackground": "#0969da33",
    "editor.lineHighlightBackground": "#eaeef280",
    "editorCursor.foreground": "#0969da",
    "editorRuler.foreground": "#d8dee4",
    "textLink.foreground": "#0969da",
    "titleBar.activeBackground": "#f6f8fa",
    "titleBar.activeForeground": "#1f2328",
    "titleBar.border": "#d0d7de",
    "menu.background": "#ffffff",
    "menu.foreground": "#1f2328",
    "menu.selectionBackground": "#eaeef2",
    "menu.separatorBackground": "#d0d7de",
    "statusBar.background": "#f6f8fa",
    "statusBar.foreground": "#57606a",
    "editorGroupHeader.tabsBackground": "#f6f8fa",
    "tab.activeBackground": "#ffffff",
    "tab.inactiveBackground": "#f6f8fa",
    "tab.hoverBackground": "#eaeef2",
    "tab.activeForeground": "#1f2328",
    "tab.inactiveForeground": "#57606a",
    "tab.activeBorderTop": "#fd8c73",
    "tab.border": "#d0d7de"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6e7781", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#0a3069" } },
    { "scope": ["constant.numeric", "constant", "constant.language"], "settings": { "foreground": "#0550ae" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#cf222e" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#cf222e" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#8250df" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#953800" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#953800" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#116329" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#0550ae" } },
    { "scope": ["meta.preprocessor", "keyword.control.directive"], "settings": { "foreground": "#9a6700" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#0550ae", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#116329" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#82071e" } },
    { "scope": ["markup.inline.raw", "markup.raw"], "settings": { "foreground": "#0a3069" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#0550ae" } },
    { "scope": ["invalid"], "settings": { "foreground": "#82071e" } },
    // Scopes for the styles that VS Code themes usually do not have a rule for (Syntax and Synta, the Total Commander plugin, use them).
    { "scope": ["keyword.control.flow"], "settings": { "foreground": "#cf222e" } },
    { "scope": ["entity.other.inherited-class"], "settings": { "foreground": "#953800" } },
    { "scope": ["keyword.other.unit"], "settings": { "foreground": "#8250df" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#0550ae" } },
    { "scope": ["meta.annotation"], "settings": { "foreground": "#cf222e" } },
    { "scope": ["constant.character.entity"], "settings": { "foreground": "#953800" } },
    { "scope": ["entity.name.section"], "settings": { "foreground": "#953800", "fontStyle": "bold" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#24292fb3" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#9a6700" } }
  ]
}
