{
  // Ayu colour palette (MIT, github.com/ayu-theme), VS Code colour theme format. Built-in theme of Syntax.
  "name": "Ayu Mirage",
  "type": "dark",
  "colors": {
    "mdview.markBackground": "#7a5d00",
    "mdview.markForeground": "#fff7cc",
    "mdview.findBackground": "#6d5200",
    "mdview.findForeground": "#fff4cb",
    "mdview.findActiveBackground": "#ffb454",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#cccac2",
    "focusBorder": "#ffcc66",
    "editor.background": "#1f2430",
    "editor.foreground": "#cccac2",
    "editor.selectionBackground": "#33415e",
    "editor.lineHighlightBackground": "#707a8c1a",
    "editor.findMatchHighlightBackground": "#ffcc6655",
    "editorCursor.foreground": "#ffcc66",
    "editorRuler.foreground": "#171b24",
    "editorLineNumber.foreground": "#707a8c99",
    "editorLineNumber.activeForeground": "#707a8c",
    "editorBracketMatch.background": "#ffcc6633",
    "editorBracketMatch.border": "#ffcc6688",
    "editorWidget.background": "#232834",
    "editorWidget.border": "#171b24",
    "input.background": "#1f2430",
    "input.border": "#171b24",
    "inputOption.activeBackground": "#ffcc6633",
    "inputOption.activeBorder": "#ffcc66",
    "textLink.foreground": "#ffcc66",
    "titleBar.activeBackground": "#1c212b",
    "titleBar.activeForeground": "#cccac2",
    "titleBar.inactiveForeground": "#8a9199",
    "titleBar.border": "#171b24",
    "menu.background": "#232834",
    "menu.foreground": "#cccac2",
    "menu.selectionBackground": "#33415e",
    "menu.selectionForeground": "#cccac2",
    "menu.separatorBackground": "#171b24",
    "menu.border": "#171b24",
    "statusBar.background": "#1c212b",
    "statusBar.foreground": "#8a9199",
    "editorGroupHeader.tabsBackground": "#1c212b",
    "tab.activeBackground": "#1f2430",
    "tab.inactiveBackground": "#1c212b",
    "tab.hoverBackground": "#232834",
    "tab.activeForeground": "#cccac2",
    "tab.inactiveForeground": "#8a9199",
    "tab.activeBorderTop": "#ffcc66",
    "tab.border": "#171b24",
    "minimap.background": "#1f2430",
    "scrollbarSlider.background": "#8a919933",
    "scrollbarSlider.hoverBackground": "#8a919955",
    "scrollbarSlider.activeBackground": "#8a919977"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#707a8c", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#d5ff80" } },
    { "scope": ["constant.numeric", "constant", "constant.language"], "settings": { "foreground": "#dfbfff" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#ffad66" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#f29e74" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#ffd173" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#73d0ff" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#cccac2" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#5ccfe6" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#ffd173" } },
    { "scope": ["meta.preprocessor", "keyword.control.directive"], "settings": { "foreground": "#ffad66" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#ffd173", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#d5ff80" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#ff6666" } },
    { "scope": ["markup.inline.raw", "markup.raw"], "settings": { "foreground": "#d5ff80" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#ffd173" } },
    { "scope": ["invalid"], "settings": { "foreground": "#ff6666" } },
    // Scopes for the styles that VS Code themes usually do not have a rule for (Syntax and Synta, the Total Commander plugin, use them).
    { "scope": ["keyword.control.flow"], "settings": { "foreground": "#f29e74" } },
    { "scope": ["entity.other.inherited-class"], "settings": { "foreground": "#ffe073" } },
    { "scope": ["keyword.other.unit"], "settings": { "foreground": "#f28fc4" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#95e6cb" } },
    { "scope": ["meta.annotation"], "settings": { "foreground": "#ffdfb3" } },
    { "scope": ["constant.character.entity"], "settings": { "foreground": "#95e6cb" } },
    { "scope": ["entity.name.section"], "settings": { "foreground": "#73d0ff", "fontStyle": "bold" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#cccac2b3" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#80bfff" } }
  ]
}
