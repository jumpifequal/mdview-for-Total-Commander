{
  // Tokyo Night palette (MIT, github.com/folke/tokyonight.nvim), VS Code colour theme format. Built-in theme of Syntax.
  "name": "Tokyo Night",
  "type": "dark",
  "colors": {
    "mdview.markBackground": "#7a5d00",
    "mdview.markForeground": "#fff7cc",
    "mdview.findBackground": "#6d5200",
    "mdview.findForeground": "#fff4cb",
    "mdview.findActiveBackground": "#ffb454",
    "mdview.findActiveForeground": "#24292e",
    "foreground": "#c0caf5",
    "focusBorder": "#7aa2f7",
    "editor.background": "#1a1b26",
    "editor.foreground": "#c0caf5",
    "editor.selectionBackground": "#283457",
    "editor.lineHighlightBackground": "#1e202e",
    "editor.findMatchHighlightBackground": "#7aa2f755",
    "editorCursor.foreground": "#c0caf5",
    "editorRuler.foreground": "#101014",
    "editorLineNumber.foreground": "#3b4261",
    "editorLineNumber.activeForeground": "#737aa2",
    "editorBracketMatch.background": "#7aa2f733",
    "editorBracketMatch.border": "#7aa2f788",
    "editorWidget.background": "#16161e",
    "editorWidget.border": "#101014",
    "input.background": "#1a1b26",
    "input.border": "#101014",
    "inputOption.activeBackground": "#7aa2f733",
    "inputOption.activeBorder": "#7aa2f7",
    "textLink.foreground": "#7aa2f7",
    "titleBar.activeBackground": "#16161e",
    "titleBar.activeForeground": "#c0caf5",
    "titleBar.inactiveForeground": "#a9b1d6",
    "titleBar.border": "#101014",
    "menu.background": "#16161e",
    "menu.foreground": "#c0caf5",
    "menu.selectionBackground": "#283457",
    "menu.selectionForeground": "#c0caf5",
    "menu.separatorBackground": "#101014",
    "menu.border": "#101014",
    "statusBar.background": "#16161e",
    "statusBar.foreground": "#a9b1d6",
    "editorGroupHeader.tabsBackground": "#16161e",
    "tab.activeBackground": "#1a1b26",
    "tab.inactiveBackground": "#16161e",
    "tab.hoverBackground": "#16161e",
    "tab.activeForeground": "#c0caf5",
    "tab.inactiveForeground": "#a9b1d6",
    "tab.activeBorderTop": "#7aa2f7",
    "tab.border": "#101014",
    "minimap.background": "#1a1b26",
    "scrollbarSlider.background": "#a9b1d633",
    "scrollbarSlider.hoverBackground": "#a9b1d655",
    "scrollbarSlider.activeBackground": "#a9b1d677"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#565f89", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#9ece6a" } },
    { "scope": ["constant.numeric", "constant", "constant.language"], "settings": { "foreground": "#ff9e64" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#bb9af7" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#89ddff" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#7aa2f7" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#2ac3de" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#c0caf5" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#f7768e" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#bb9af7" } },
    { "scope": ["meta.preprocessor", "keyword.control.directive"], "settings": { "foreground": "#bb9af7" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#7aa2f7", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#9ece6a" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#db4b4b" } },
    { "scope": ["markup.inline.raw", "markup.raw"], "settings": { "foreground": "#9ece6a" } },
    { "scope": ["support.type.property-name"], "settings": { "foreground": "#bb9af7" } },
    { "scope": ["invalid"], "settings": { "foreground": "#db4b4b" } },
    // Scopes for the styles that VS Code themes usually do not have a rule for (Syntax and Synta, the Total Commander plugin, use them).
    { "scope": ["keyword.control.flow"], "settings": { "foreground": "#bb9af7" } },
    { "scope": ["entity.other.inherited-class"], "settings": { "foreground": "#2ac3de" } },
    { "scope": ["keyword.other.unit"], "settings": { "foreground": "#ff9e64" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#89ddff" } },
    { "scope": ["meta.annotation"], "settings": { "foreground": "#bb9af7" } },
    { "scope": ["constant.character.entity"], "settings": { "foreground": "#73dafa" } },
    { "scope": ["entity.name.section"], "settings": { "foreground": "#2ac3de", "fontStyle": "bold" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#c0caf5b3" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#7aa2f7" } }
  ]
}
